{
    // This folder is its own workspace root (see ../../glasshouse.code-workspace),
    // so ${workspaceFolder} below unambiguously means api/ -- no
    // qualifier needed, and .venv/bin/python is *this* folder's venv.
    "version": "0.2.0",
    "configurations": [
        {
            // Run the actual dev server under the debugger -- breakpoints
            // in main.py / quote.py hit on real incoming requests, e.g.
            // from curl or /docs, not just from pytest.
            "name": "Run dev server (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "uvicorn",
            "args": ["glasshouse_api.main:app", "--reload", "--port", "8000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            // The single most illustrative test to step through: it's the
            // only route that touches every part of the system --
            // settlement engine (like /settle), forecaster (like
            // /forecast/*), and quote.py's own portfolio-building logic,
            // all in one request. Good starting breakpoint: the first
            // line inside quote() in main.py.
            "name": "pytest: test_quote_ties_settlement_and_benchmark_together",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": [
                "tests/test_quote.py::test_quote_ties_settlement_and_benchmark_together",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": ["${file}", "-v", "-s"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
