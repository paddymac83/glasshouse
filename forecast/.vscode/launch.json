{
    // This folder is its own workspace root (see ../../glasshouse.code-workspace),
    // so ${workspaceFolder} below unambiguously means forecast/ -- no
    // qualifier needed, and .venv/bin/python is *this* folder's venv.
    "version": "0.2.0",
    "configurations": [
        {
            // Fixed target, no dependency on which editor tab has focus.
            "name": "pytest: test_forecast_system_prices_reads_from_sqlite",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": [
                "tests/test_forecaster.py::test_forecast_system_prices_reads_from_sqlite",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            // General-purpose: debugs every test in whichever forecast
            // test file you currently have open and focused. If this
            // doesn't seem to hit your breakpoint, ${file} probably
            // wasn't pointing at the file you thought -- use a fixed
            // node-id config like the one above instead.
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": ["${file}", "-v", "-s"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
